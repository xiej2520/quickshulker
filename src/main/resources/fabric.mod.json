{
  "schemaVersion": 1,
  "id": "quickshulker",
  "version": "${mod_version}",
  "name": "Quick Shulker",
  "description": "Quickly open Shulker boxes and more. Backport of newer versions of quickshulker to 1.15 by xiej2520. Using kyrptconfig ~1.2.2 backported to 1.15.",
  "authors": [
    "kyrptonaught",
    "xiej2520"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/quick-shulker",
    "sources": "https://github.com/kyrptonaught/quickshulker"
  },
  "license": "MIT",
  "icon": "assets/quickshulker/icon.png",
  "environment": "*",
  "mixins": [
    "net.kyrptonaught.quickshulker.json",
    "net.kyrptonaught.shulkerutils.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "net.kyrptonaught.quickshulker.QuickShulkerMod"
    ],
    "quickshulker": [
      "net.kyrptonaught.quickshulker.QuickShulkerMod"
    ],
    "client": [
      "net.kyrptonaught.quickshulker.client.QuickShulkerModClient"
    ],
    "modmenu": [
      "net.kyrptonaught.quickshulker.config.modmenu.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.4.0",
    "fabric": "*"
  },
  "accessWidener": "quickshulker.accesswidener"
}
